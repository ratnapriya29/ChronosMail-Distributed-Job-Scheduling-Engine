# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
# Example local docker: postgresql://postgres:postgrespassword@localhost:5432/reachinbox_scheduler?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/reachinbox_scheduler?schema=public"

# Redis (BullMQ & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch (Fulltext Search)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# Queue & Worker Settings
WORKER_CONCURRENCY=5
# Minimum intentional delay between consecutive emails per worker (in ms)
PROVIDER_THROTTLE_DELAY_MS=2000
# Maximum emails per hour allowed per sender before rescheduling
MAX_EMAILS_PER_HOUR_PER_SENDER=5

# Slack Integration (Webhook or OAuth)
# Paste incoming webhook URL here or connect dynamically via UI
SLACK_DEFAULT_WEBHOOK_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth/callback

# Ethereal Email Credentials (optional - auto-generates test account if empty)
ETHEREAL_USER=
ETHEREAL_PASS=
